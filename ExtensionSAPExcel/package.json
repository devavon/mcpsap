{
  "name": "sap-excel-addin",
  "version": "1.0.0",
  "description": "Add-in de Excel (Office.js) para consultar datos de SAP Business One vía el backend MCPSAP (API REST de solo lectura).",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dist": "webpack --mode production && node scripts/build-prod.mjs",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "certs": "office-addin-dev-certs install"
  },
  "dependencies": {
    "core-js": "^3.37.0"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.377",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-debugging": "^6.0.0",
    "office-addin-dev-certs": "^2.0.0",
    "office-addin-manifest": "^2.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
